# Provedor de LLM (Ollama local)
LLM_PROVIDER=ollama
LLM_API_KEY=nao_precisa
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Configurações do Agente
MAX_AGENT_ITERATIONS=6
REFERENCE_DATETIME=2026-10-10T21:00:00-03:00

# Caminhos dos Dados (deve bater com o config.py)
PEDIDOS_PATH=data/pedidos.json
POLITICAS_PATH=data/politicas.md

# Regras de Negócio (blindadas no código)
MAX_REFUND_AUTO=50.0
CLAIM_WINDOW_DAYS=7
DELAY_THRESHOLD_MINUTES=30
DELAY_REFUND_PERCENT=0.20
